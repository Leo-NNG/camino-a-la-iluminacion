# Copia este archivo como .env (que NO se sube al repositorio) y completa los valores.
# PowerShell:  Copy-Item .env.example .env ; notepad .env

# Contraseña del usuario root de MariaDB (solo la usa el contenedor de la base).
DB_ROOT_PASSWORD=
# Usuario y contraseña con los que la aplicación entra a la base (sin privilegios de administrador).
DB_USER=cai_app
DB_PASSWORD=

# Clave de cifrado del DNI: 32 bytes en base64. Generar UNA vez y respaldarla (sin ella no se leen los DNI).
#   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
#   Linux/macOS: openssl rand -base64 32
CAI_DATA_KEY=

# Opcionales
APP_PUERTO=8080
CAI_URL_PUBLICA=
FACTILIZA_TOKEN=
